//  tcd_memory_cluster  dir                                     tcd_mem_cluster_lib tcd_mem_cluster_lib.gz
//  command: report_config_data -partition tcd -levels 1

// Tessent memory description (TCD) for SYNC_1RW_64x8.
// Core name must equal the RAM module name; Port names must equal the RAM pins.
Core(SYNC_1RW_64x8) {
  tessent_tool_version : 2022.4;
  tessent_meta_version : 10;
  Memory {
    // Not shown
  }
}
